@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

'------------------------
' Участники (People)
'------------------------
Person(customer, "Клиент банка", "Физическое лицо, использующее услуги банка")
Person(branchEmp, "Сотрудник отделения", "Фронт-офис: операции с клиентами в отделениях")
Person(boLoans, "Менеджер бэк-офиса кредитов", "Обрабатывает заявки на кредиты")

'------------------------
' Системы банка
'------------------------
System_Boundary(bank, "Банк «Стандарт»") {
  System(site, "Сайт банка", "Веб-сайт для новых клиентов")
  System(ib, "Интернет-банк", "Веб-приложение для существующих клиентов")
  System(loanPipeline, "Кредитный конвейер", "Система обработки заявок на кредиты")
  System(scoring, "Система кредитного скоринга", "Расчет кредитного скоринга")
  System(abs, "АБС", "Автоматизированная банковская система")
  System(smsGateway, "СМС-шлюз банка", "Отправка СМС через телеком-оператора")
}

'------------------------
' Внешние системы
'------------------------
System_Ext(bki, "Бюро кредитных историй", "Внешнее БКИ для получения кредитных историй")
System_Ext(telecom, "Телеком-оператор", "Внешний оператор связи для СМС")

'------------------------
' Связи: люди ↔ системы
'------------------------
Rel(customer, site, "Просматривает кредиты, подает заявку", "HTTPS")
Rel(customer, ib, "Просматривает кредиты, подает заявку", "HTTPS")
Rel(customer, branchEmp, "Идентификация в отделении", "Личное обращение")
Rel(customer, telecom, "Получает СМС-уведомления", "SMS")
Rel(branchEmp, abs, "Оформляет кредит после идентификации", "Толстый клиент")
Rel(boLoans, loanPipeline, "Обрабатывает заявки на кредиты", "Веб-интерфейс")

'------------------------
' Связи: системы ↔ системы
'------------------------
Rel(site, scoring, "Передает данные для скоринга", "HTTPS/API")
Rel(scoring, bki, "Запрашивает кредитные истории", "API")
Rel(site, loanPipeline, "Сохраняет заявку", "HTTPS/API")
Rel(ib, loanPipeline, "Передает заявки на кредиты", "Асинхронно через очередь")
Rel(ib, loanPipeline, "Запрашивает предодобренные предложения", "HTTPS/API")
Rel(loanPipeline, scoring, "Запрашивает скоринг заявок", "HTTPS/API")
Rel(loanPipeline, abs, "Синхронизирует заявки", "Батч раз в сутки + очередь")
Rel(abs, loanPipeline, "Передает заявки из отделений", "Батч раз в сутки")
Rel(loanPipeline, smsGateway, "Отправка СМС-уведомлений", "API")
Rel(smsGateway, telecom, "Передача СМС-сообщений", "SMPP/HTTPS")

@enduml

