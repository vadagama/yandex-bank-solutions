@startuml
' Подключение C4-модели (при необходимости путь можно заменить локальным файлом)
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

'------------------------
' Участники (People)
'------------------------
Person(customer, "Клиент банка", "Физическое лицо, использующее услуги банка.")
Person(branchEmp, "Сотрудник отделения", "Фронт-офис: операции с клиентами в 50 отделениях.")
Person(ccOperator, "Оператор кол-центра", "Отвечает на звонки, создаёт обращения.")
Person(boDeposits, "Бэк-офис депозитов", "Рассчитывает и согласует ставки по депозитам.")
Person(boCredits, "Бэк-офис кредитов", "Рассматривает заявки на кредиты.")
Person(itStaff, "IT-отдел", "Сопровождение АБС, интернет-банка, интеграций.")
Person(digitalTeam, "Команда цифровой трансформации", "Развитие онлайн-каналов и автоматизации.")

'------------------------
' Системы банка
'------------------------
System_Boundary(bank, "Банк «Стандарт»") {

  System(ABS, "АБС", "Автоматизированная банковская система")
  System(IB, "Интернет-банк", "Веб-приложение")
  System(Site, "Сайт банка", "Веб-сайт")
  System(CCSys, "Система кол-центра", "Контакт-центр банка")
  System(SMSGateway, "СМС-шлюз банка", "Отправка СМС через телеком-оператора.")
  System(CreditPipeline, "Кредитный конвейер", "Система обработки кредитных заявок")
  System(Scoring, "Система кредитного скоринга", "ML-сервис скоринга",)
  System(ExcelRates, "Excel-файлы депозитных ставок", "Excel-расчёты на основе ставки рефинансирования и уровня кредитного риска.")

  ' Можно считать партнёрский кол-центр внешней системой, но логически он связан с внутренней
  System(CCScripts, "Скрипты партнёрского кол-центра", "Набор сценариев звонков")
}

'------------------------
' Внешние системы
'------------------------
System_Ext(PartnerCC, "Партнёрский кол-центр", "Внешняя система")
System_Ext(Telecom, "Телеком-оператор", "Внешний оператор связи")
System_Ext(CreditBureau, "Бюро кредитных историй", "Внешний сервис")

'------------------------
' Связи: люди ↔ системы
'------------------------
Rel(customer, Site, "Смотрит маркетинговую информацию", "HTTPS")
Rel(customer, IB, "Проводит платежи, открывает текущие счета", "HTTPS")
Rel(customer, branchEmp, "Офлайн-обслуживание в отделении", "Личное обращение")
Rel(customer, ccOperator, "Звонит по вопросам вкладов и кредитов", "Телефон")
Rel(customer, Telecom, "Получает СМС-уведомления", "SMS")

Rel(branchEmp, ABS, "Оформляет депозиты и кредиты, проводит операции", "Толстый клиент / LAN")
Rel(boDeposits, ExcelRates, "Поддерживает и обновляет файл ставок", "Файл Excel")
Rel(boDeposits, ABS, "Определяет ставки по заявкам, вносит в систему", "Толстый клиент")
Rel(boCredits, ABS, "Анализирует кредитный риск по клиенту", "Толстый клиент")
Rel(boCredits, CreditPipeline, "Рассматривает и одобряет кредитные заявки", "Web-интерфейс/толстый клиент Camunda")

Rel(ccOperator, CCSys, "Регистрирует обращения клиентов", "Веб-интерфейс")
Rel(digitalTeam, IB, "Планирует и инициирует изменения", "ТЗ, задачи")
Rel(digitalTeam, Site, "Развивает онлайн-каналы", "ТЗ, задачи")
Rel(itStaff, ABS, "Сопровождение и доработка", "")
Rel(itStaff, CCSys, "Работа с подрядчиком по сопровождению", "")
Rel(itStaff, CreditPipeline, "Совместная доработка процессов", "")
Rel(itStaff, Scoring, "Разработка и поддержка ML-модели", "")

'------------------------
' Связи: системы ↔ системы (потоки данных)
'------------------------

' Интернет-каналы
Rel(Site, IB, "Переходы клиентов в интернет-банк", "HTTPS / ссылки")
Rel(IB, ABS, "Платежи, открытие текущих счетов (операции по счетам)", "Интеграция по БД / внутренний канал")

' Кол-центр
Rel(customer, CCSys, "Телефонные звонки, регистрация обращений", "Голосовой трафик / SIP")
Rel(CCSys, ABS, "Передача обращений, запрос информации о клиентах", "Интеграция (API/БД)")
Rel(PartnerCC, CCSys, "Передача обращений по скриптам банка", "Интеграция платформ партнёров")
Rel(CCScripts, PartnerCC, "Передача скриптов звонков", "Файлы / инструкции")

' Депозиты
Rel(ExcelRates, ABS, "Ежедневные обновлённые ставки депозитов", "Файлы Excel, почта")
Rel(ABS, SMSGateway, "СМС-оповещения о готовности депозита и ставках", "Внутренний протокол / API")
Rel(SMSGateway, Telecom, "Передача СМС-сообщений", "SMPP / HTTPS")
Rel(Telecom, customer, "Доставка СМС", "SMS")

' Кредиты
Rel(branchEmp, ABS, "Заявки на кредит", "Толстый клиент")
Rel(ABS, CreditPipeline, "Заявки на кредит (пакетно 1 раз в сутки)", "Интеграция по БД / batch")
Rel(CreditPipeline, Scoring, "Запрос скоринговой оценки", "REST API")
Rel(Scoring, CreditBureau, "Запрос кредитной истории", "REST API")
Rel(CreditBureau, Scoring, "Кредитная история клиента", "JSON/HTTP")
Rel(Scoring, CreditPipeline, "Результат скоринга", "REST API")
Rel(CreditPipeline, ABS, "Решение по кредиту, статусы заявок (1 раз в сутки)", "Интеграция по БД / batch")

@enduml
