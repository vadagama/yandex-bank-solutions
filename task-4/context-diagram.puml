@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

'------------------------
' Участники (People)
'------------------------
Person(ccOperator, "Оператор кол-центра", "Консультирует клиентов по ставкам")
Person(partnerCCOperator, "Оператор партнёрского кол-центра", "Консультирует клиентов по ставкам")
Person(boDeposits, "Менеджер бэк-офиса депозитов", "Управляет ставками по депозитам")

'------------------------
' Системы банка
'------------------------
System_Boundary(bank, "Банк «Стандарт»") {
  System(ccSys, "Система кол-центра", "Контакт-центр банка")
  System(abs, "АБС", "Автоматизированная банковская система")
  System(sftpServer, "SFTP-сервер", "Сервер для передачи файлов партнёру")
}

'------------------------
' Внешние системы
'------------------------
System_Ext(partnerCC, "Партнёрский кол-центр", "Внешний кол-центр партнёра")

'------------------------
' Связи: люди ↔ системы
'------------------------
Rel(ccOperator, ccSys, "Просматривает ставки, консультирует клиентов", "Веб-интерфейс")
Rel(partnerCCOperator, partnerCC, "Просматривает ставки, консультирует клиентов", "Веб-интерфейс")
Rel(boDeposits, abs, "Управляет ставками по депозитам", "Веб-интерфейс")

'------------------------
' Связи: системы ↔ системы
'------------------------
Rel(ccSys, abs, "Запрашивает актуальные ставки", "REST API")
Rel(abs, ccSys, "Уведомляет об изменении ставок", "Очередь сообщений")
Rel(abs, sftpServer, "Загружает файлы со ставками", "SFTP")
Rel(sftpServer, partnerCC, "Предоставляет файлы со ставками", "SFTP")
Rel(partnerCC, sftpServer, "Загружает файлы со ставками", "SFTP")

@enduml

