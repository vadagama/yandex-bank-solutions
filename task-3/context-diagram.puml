@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

'------------------------
' Участники (People)
'------------------------
Person(customer, "Клиент банка", "Физическое лицо, использующее услуги банка")
Person(branchEmp, "Сотрудник отделения", "Фронт-офис: операции с клиентами в отделениях")
Person(ccOperator, "Оператор кол-центра", "Обрабатывает заявки с сайта, звонит клиентам")
Person(boDeposits, "Менеджер бэк-офиса депозитов", "Обрабатывает заявки на депозиты, управляет ставками")

'------------------------
' Системы банка
'------------------------
System_Boundary(bank, "Банк «Стандарт»") {
  System(site, "Сайт банка", "Веб-сайт для новых клиентов")
  System(ib, "Интернет-банк", "Веб-приложение для существующих клиентов")
  System(ccSys, "Система кол-центра", "Контакт-центр банка")
  System(abs, "АБС", "Автоматизированная банковская система")
  System(smsGateway, "СМС-шлюз банка", "Отправка СМС через телеком-оператора")
}

'------------------------
' Внешние системы
'------------------------
System_Ext(telecom, "Телеком-оператор", "Внешний оператор связи для СМС")

'------------------------
' Связи: люди ↔ системы
'------------------------
Rel(customer, site, "Просматривает депозиты, подает заявку", "HTTPS")
Rel(customer, ib, "Просматривает депозиты, подает заявку", "HTTPS")
Rel(customer, branchEmp, "Идентификация в отделении", "Личное обращение")
Rel(customer, ccOperator, "Получает звонок по заявке", "Телефон")
Rel(customer, telecom, "Получает СМС-уведомления", "SMS")

Rel(branchEmp, abs, "Оформляет депозит после идентификации", "Толстый клиент")
Rel(ccOperator, ccSys, "Обрабатывает заявки с сайта", "Веб-интерфейс")
Rel(boDeposits, abs, "Обрабатывает заявки, управляет ставками", "Веб-интерфейс")

'------------------------
' Связи: системы ↔ системы
'------------------------
Rel(site, ccSys, "Передает заявки на депозиты", "HTTPS/API")
Rel(ib, abs, "Передает заявки на депозиты", "Асинхронно через очередь")
Rel(ccSys, abs, "Передает заявки из кол-центра", "API/БД")
Rel(abs, smsGateway, "Отправка СМС-уведомлений", "API")
Rel(smsGateway, telecom, "Передача СМС-сообщений", "SMPP/HTTPS")

@enduml

